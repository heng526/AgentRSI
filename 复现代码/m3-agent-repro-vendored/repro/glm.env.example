# Copy to ~/.config/m3-agent/glm.env on node01 and set chmod 600.
# Alibaba Model Studio: Beijing-region key; activate ZHIPU/GLM-5.3-Flash first.
# The Beijing DashScope domain is simplest for first use; a Beijing workspace
# endpoint can be substituted later if desired.
GLM_API_PROVIDER=bailian
GLM_API_KEY=
GLM_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
GLM_CHAT_MODEL=ZHIPU/GLM-5.3-Flash
GLM_EMBEDDING_MODEL=text-embedding-v4
# For BigModel general API instead: provider=glm, base=/api/paas/v4,
# chat_model=glm-5.3-flash, embedding_model=embedding-3.
